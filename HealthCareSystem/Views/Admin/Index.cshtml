@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Admin Dashboard";
}
<!-- Main Content -->
<div class="main-content">
    <!-- Header -->
    <header class="header">
        <h1 class="header-title">Admin Dashboard</h1>
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search..." id="searchInput">
        </div>
        <div class="header-actions">
            <button class="notification-btn">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">5</span>
            </button>
            <div class="user-profile">
                <img src="/placeholder.svg?height=32&width=32" alt="Admin" class="user-avatar">
                <div class="user-info">
                    <h6 id="adminName">Admin User</h6>
                    <p>Administrator</p>
                </div>
            </div>
        </div>
    </header>

    <div class="container-fluid p-4">
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Patients</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalPatients">0</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    <span id="patientGrowth" class="text-success mr-2"></span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Patients</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800" id="activePatients">0</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    <span id="newPatients" class="text-info mr-2"></span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-user-check fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Appointments</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalAppointments">0</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    <span id="confirmedGrowth" class="text-success mr-2"></span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending Appointments</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800" id="pendingAppointments">0</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    <span id="pendingGrowth" class="text-warning mr-2"></span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-clock fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row">
            <!-- Appointment Trends Chart -->
            <div class="col-xl-8 col-lg-7">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary">Appointment Trends</h6>
                        <div class="dropdown no-arrow">
                            <select id="periodSelector" class="form-select form-select-sm" onchange="changePeriod()">
                                <option value="daily">Daily (Last 7 days)</option>
                                <option value="weekly">Weekly (Last 12 weeks)</option>
                                <option value="monthly" selected>Monthly (Last 12 months)</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart-area">
                            <canvas id="appointmentTrendsChart"></canvas>
                        </div>
                        <div class="mt-4 text-center">
                            <div class="row">
                                <div class="col">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Average</div>
                                    <div class="h6 mb-0 font-weight-bold" id="averageAppointments">0</div>
                                </div>
                                <div class="col">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Peak</div>
                                    <div class="h6 mb-0 font-weight-bold" id="peakAppointments">0</div>
                                </div>
                                <div class="col">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Total</div>
                                    <div class="h6 mb-0 font-weight-bold" id="totalPeriodAppointments">0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Patient Status Chart -->
            <div class="col-xl-4 col-lg-5">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Patient Status Distribution</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-pie pt-4 pb-2">
                            <canvas id="patientStatusChart"></canvas>
                        </div>
                        <div class="mt-4 text-center small" id="patientStatusLegend">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Second Row Charts -->
        <div class="row">
            <!-- Appointment Overview Chart -->
            <div class="col-xl-8 col-lg-7">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Appointment Overview (Confirmed vs Pending)</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-area">
                            <canvas id="appointmentOverviewChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Patients -->
            <div class="col-xl-4 col-lg-5">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Recent Patient Registrations</h6>
                    </div>
                    <div class="card-body">
                        <div id="recentPatientsList">
                            <!-- Dynamic content -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/admin/admin-dashboard.js"></script>
