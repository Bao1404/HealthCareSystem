@model DoctorAndPatientViewModel
@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Patients";
}
<!-- Main Content -->
<div class="main-content">
    <!-- Header -->
    <header class="header">
        <h1 class="header-title">My Patients</h1>
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search patients..." id="searchInput">
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="openAddPatientModal()">
                <i class="fas fa-user-plus"></i>
                Add Patient
            </button>
            <button class="notification-btn">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">5</span>
            </button>
            <a class="user-profile" asp-action="Profile" asp-controller="Doctor">
                <img src="@Model.Doctor.User.AvatarUrl" alt="Doctor" class="user-avatar">
                <div class="user-info">
                    <h6 id="">@Model.Doctor.User.FullName</h6>
                    <p>@Model.Doctor.Specialty.Name</p>
                </div>
            </a>
        </div>
    </header>

    <!-- Content -->
    <div class="content">
        <!-- Patient Filters -->
        @* <div class="dashboard-card">
            <div class="card-content">
                <div class="patient-filters">
                    <button class="filter-btn active" onclick="filterPatients('all')">All Patients</button>
                    <button class="filter-btn" onclick="filterPatients('active')">Active</button>
                    <button class="filter-btn" onclick="filterPatients('critical')">Critical</button>
                    <button class="filter-btn" onclick="filterPatients('follow-up')">Follow-up</button>
                    <button class="filter-btn" onclick="filterPatients('new')">New</button>
                </div>
            </div>
        </div> *@

        <!-- Patients Grid -->
        <div class="patients-grid" id="patientsGrid" style="padding-top: 10px">
            @foreach (var patient in Model.Patients)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <div>
                            <div class="d-flex">
                                <div class="me-4">
                                    <!-- Avatar and name -->
                                    <div class="text-center">
                                        <img src="@patient.User.AvatarUrl" alt="@patient.User.FullName" class="profile-avatar-xl rounded-circle mb-3" style="width: 120px; height: 120px;">
                                        <h5>@patient.User.FullName</h5>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex-grow-1">
                                        <!-- Patient Info -->
                                        <div class="row g-1">
                                            <div >
                                                <p class="">Email: @patient.User.Email</p>
                                            </div>
                                            <div >
                                                <p class="">Phone: @patient.User.PhoneNumber</p>
                                            </div>
                                            <div >
                                                <p class="">Gender: @patient.Gender</p>
                                            </div>
                                            <div >
                                                <p class="">Blood type: @patient.BloodType</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: flex-end">
                                <form id="sendEmailForm">
                                    <button type="submit" class="btn btn-primary">Medication Reminder</button>
                                </form>

                                <!-- Phần hiển thị thông báo -->
                                <div id="message"></div>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

<!-- Add Patient Modal -->
<div class="modal fade" id="addPatientModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addPatientForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstName" class="form-label">First Name</label>
                            <input type="text" class="form-control" id="firstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="lastName" class="form-label">Last Name</label>
                            <input type="text" class="form-control" id="lastName" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="phone" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="dateOfBirth" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" id="dateOfBirth" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="gender" class="form-label">Gender</label>
                            <select class="form-control" id="gender" required>
                                <option value="">Select Gender</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea class="form-control" id="address" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="emergencyContact" class="form-label">Emergency Contact</label>
                            <input type="text" class="form-control" id="emergencyContact">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="emergencyPhone" class="form-label">Emergency Phone</label>
                            <input type="tel" class="form-control" id="emergencyPhone">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="medicalHistory" class="form-label">Medical History</label>
                        <textarea class="form-control" id="medicalHistory" rows="3" placeholder="Brief medical history..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addPatient()">Add Patient</button>
            </div>
        </div>
    </div>
</div>

<!-- Patient Details Modal -->
<div class="modal fade" id="patientDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientDetailsTitle">Patient Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="patientDetailsBody">
                <!-- Populated by JavaScript -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="scheduleAppointmentForPatient()">Schedule Appointment</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#sendEmailForm').submit(function(event) {
            event.preventDefault();  

            // Gửi AJAX request
            $.ajax({
                url: '/sendMail', // Đường dẫn đến action
                type: 'POST',
                success: function(response) {
                    // Hiển thị thông báo thành công
                    if (response.success) {
                        $('#message').html('<div class="alert alert-success">' + response.message + '</div>');
                    } else {
                        // Hiển thị thông báo lỗi
                        $('#message').html('<div class="alert alert-danger">' + response.message + '</div>');
                    }
                },
                error: function(xhr, status, error) {
                    // Nếu có lỗi trong quá trình AJAX
                    $('#message').html('<div class="alert alert-danger">Something went wrong, please try again later.</div>');
                }
            });
        });
    });
</script>


<script src="~/js/doctor/patients.js"></script>
